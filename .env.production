# ⚠ ЭТОТ ФАЙЛ В GIT И ПОПАДАЕТ В КЛИЕНТСКИЙ БАНДЛ ЦЕЛИКОМ.
# Vite инлайнит КАЖДУЮ переменную с префиксом VITE_ в js, который скачивает
# каждый посетитель. Поэтому здесь живут только публичные по замыслу значения.
# НИКОГДА не давай серверному секрету префикс VITE_ — он утечёт всем, и отзыв
# ключа будет единственным способом это починить. Серверные секреты лежат в
# Supabase Vault и читаются через unloop_get_secret.
# Проверка обоих концов правила: `npm run check:secrets` (блокирует CI).

# Supabase publishable credentials (safe to commit — anon key is public by design)
VITE_SUPABASE_URL=https://ncfpxetzmeeqxgqidosj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5jZnB4ZXR6bWVlcXhncWlkb3NqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjYyMTk4NDEsImV4cCI6MjA4MTc5NTg0MX0.lNmvsQc5e6VvN_hbnhfzdz3Y7FhpiRNockXiXqGJ7vQ

# Payments. Provider: "polar" (primary; all config server-side in Supabase
# Vault) or "paddle" (fallback; needs the client token + price id below).
# SANDBOX-TEST MODE: flag is on while Vault has POLAR_ENV=sandbox — checkout
# opens Polar sandbox (no real charges, test card 4242…). Before real launch
# either flip this back to false or switch Vault to POLAR_ENV=production with
# live POLAR_* secrets (scripts/polar-setup.mjs prints them).
VITE_PAYMENTS_ENABLED=true
VITE_PAYMENTS_PROVIDER=polar

# Credit economy (docs/credits-economy.md). Flip together with the server-side
# CREDITS_ENABLED secret in Supabase Vault: true switches both paywalls to
# credit packs, silent accounts and chat; false keeps the legacy $14.99 flow.
# LIVE since 27.07.2026 (Vault flag is also true) — E2E-verified pipeline.
VITE_CREDITS_ENABLED=true

# Looplore+ subscription (docs/subscription-economy.md). Flip together with the
# server-side SUBSCRIPTIONS_ENABLED secret in Supabase Vault: true shows the
# subscription card on all three paywalls, the catalogue banner and the
# /account/ block; false hides them — the credit rail is untouched either way.
# LIVE since 07.08.2026 (Vault flag is also true) — synthetic-webhook E2E green.
VITE_SUBSCRIPTIONS_ENABLED=true

# Gifting (docs/gifts.md). Flip together with the server-side GIFTS_ENABLED
# secret in Supabase Vault: true opens /gift/ (buying and claiming) and adds
# "Give a gift" to the menu and the account screen; false hides the surface
# entirely. Codes already issued survive a rollback — redemption runs through
# credits-promo, which is not behind this flag.
# OFF until the founder's go: needs the migration, the three Polar products
# and the Vault flag first (docs/gifts.md §10).
VITE_GIFTS_ENABLED=false

# Compare loop and personal invite codes (docs/referrals-compare.md).
# ON since 10.08.2026: the migration 20260807190000_referrals.sql is applied in
# prod and credits-promo v3 carries the referral passthrough. This flag only
# shows or hides the surface (invite card, consent screen, code block) — the
# server-side twin is the execute grant on the compare RPCs, so flipping this
# back to false hides the UI but leaves the RPCs callable. To close it on the
# server too, run the revoke block at the end of that migration.
VITE_REFERRALS_ENABLED=true
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID=

# PostHog product analytics (EU cloud). Project API key is public by design (phc_...).
# Дашборды и схема событий: см. analytics.md
VITE_POSTHOG_KEY=phc_y3BJtEFeCiX7MCC2MkkwbnmYgEEEWK3HY3dzBLbKqvBX

# Meta (Facebook) Pixel — id из Events Manager (число). Пустой = пиксель выключен.
# Серверная часть (Conversions API) ждёт META_PIXEL_ID + META_CAPI_TOKEN в Supabase
# Vault. Пошаговая настройка и структура кампании: см. meta-ads.md
VITE_META_PIXEL_ID=1021965893920712
