{
  "name": "looplore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/generate-test-og.mjs && node tools/generate-seo.mjs",
    "preview": "vite preview",
    "tests:build": "node tools/tests-import/to-canonical.mjs",
    "tests:verify": "node tools/tests-import/verify-engine.mjs",
    "tests:fixtures": "node tools/tests-import/generate-fixtures.mjs",
    "tests:audit": "node tools/tests-audit/audit.mjs --l0",
    "tests:lint": "node tools/tests-audit/lint-weights.mjs",
    "tests:share-lint": "node tools/tests-audit/lint-share-cards.mjs",
    "tests:feeds": "node tools/tests-audit/feed-snapshot.mjs",
    "tests:feed-invariants": "node tools/tests-audit/feed-invariants.mjs",
    "tests:merch": "node tools/tests-audit/catalogue-meta.mjs",
    "tests:portrait-sim": "node tools/tests-audit/portrait-feed.mjs",
    "check:secrets": "node tools/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@polar-sh/checkout": "^0.4.0",
    "@supabase/supabase-js": "^2.49.0",
    "posthog-js": "^1.404.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
