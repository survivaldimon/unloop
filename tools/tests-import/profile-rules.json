{
  "$comment": "Э4 — правила выбора профиля, перенесённые вручную из determineProfile() каждого теста. В tests_app это Dart-код, экстрактором его не достать (docs/tests-scoring-semantics.md). Условие: [левое, оператор, правое], где операнд — число, id фактора или производное значение @avg / @range / @diff12. Правила проверяются по порядку, пустой when срабатывает всегда.",

  "attachment_styles_v1": {
    "mode": "rules",
    "fallback": "mixed",
    "rules": [
      { "when": [["secure", ">", 70], ["anxious", "<", 30], ["avoidant", "<", 30], ["fearful", "<", 30]], "profile": "secure" },
      { "when": [["anxious", ">", 60], ["anxious", ">", "avoidant"], ["anxious", ">", "fearful"]], "profile": "anxious" },
      { "when": [["avoidant", ">", 60], ["avoidant", ">", "anxious"], ["avoidant", ">", "fearful"]], "profile": "avoidant" },
      { "when": [["fearful", ">", 60]], "profile": "fearful" },
      { "when": [["anxious", ">", 50], ["avoidant", ">", 50]], "profile": "fearful" }
    ]
  },

  "friendship_red_flags_v1": {
    "mode": "rules",
    "fallback": "profile_low_risk",
    "rules": [
      { "when": [["@avg", ">=", 75]], "profile": "profile_high_risk" },
      { "when": [["@avg", ">=", 50]], "profile": "profile_elevated_risk" },
      { "when": [["@avg", ">=", 25]], "profile": "profile_moderate_risk" }
    ]
  },

  "toxic_patterns": {
    "mode": "rules",
    "fallback": "healthy_relationships",
    "rules": [
      { "when": [["@avg", ">", 80]], "profile": "severe_toxicity" },
      { "when": [["@avg", ">", 65]], "profile": "high_toxicity" },
      { "when": [["@avg", ">", 45]], "profile": "moderate_toxicity" },
      { "when": [["@avg", ">", 25]], "profile": "mild_toxicity" }
    ]
  },

  "text_conflict_communication": {
    "mode": "rules",
    "fallback": "the_mixed",
    "rules": [
      { "when": [["assertiveness", ">=", 60]], "profile": "the_assertive" },
      { "when": [["avoidance", ">=", 60]], "profile": "the_ghoster" },
      { "when": [["aggression", ">=", 60]], "profile": "the_exploder" },
      { "when": [["passive_revenge", ">=", 60]], "profile": "the_passive_avenger" }
    ]
  },

  "love_languages_v1": {
    "mode": "rules",
    "fallback": "profile_balanced",
    "rules": [
      { "when": [["@range", "<", 15]], "profile": "profile_balanced" },
      {
        "when": [["@diff12", "<", 10]],
        "profile": {
          "combo": {
            "quality_time+words_of_affirmation": "profile_words_time",
            "acts_of_service+words_of_affirmation": "profile_words_service",
            "physical_touch+words_of_affirmation": "profile_words_touch",
            "acts_of_service+quality_time": "profile_time_service",
            "physical_touch+quality_time": "profile_time_touch",
            "acts_of_service+physical_touch": "profile_service_touch",
            "quality_time+receiving_gifts": "profile_time_gifts",
            "receiving_gifts+words_of_affirmation": "profile_words_gifts"
          }
        }
      },
      {
        "when": [],
        "profile": {
          "byTop": {
            "words_of_affirmation": "profile_words",
            "quality_time": "profile_time",
            "receiving_gifts": "profile_gifts",
            "acts_of_service": "profile_service",
            "physical_touch": "profile_touch"
          }
        }
      }
    ]
  },

  "ipip_big_five": {
    "mode": "rules",
    "fallback": "profile_balanced",
    "rules": [
      { "when": [["extraversion", ">", 70], ["conscientiousness", ">", 60], ["emotional_stability", ">", 60]], "profile": "profile_leader" },
      { "when": [["extraversion", ">", 70], ["agreeableness", ">", 70]], "profile": "profile_social_butterfly" },
      { "when": [["intellect", ">", 70], ["extraversion", "<", 50]], "profile": "profile_creative_thinker" },
      { "when": [["intellect", ">", 70], ["extraversion", ">", 60]], "profile": "profile_innovator" },
      { "when": [["conscientiousness", ">", 70], ["agreeableness", ">", 60]], "profile": "profile_reliable_helper" },
      { "when": [["conscientiousness", ">", 70], ["emotional_stability", ">", 60]], "profile": "profile_achiever" },
      { "when": [["emotional_stability", "<", 30], ["agreeableness", ">", 60]], "profile": "profile_sensitive_soul" },
      { "when": [["emotional_stability", "<", 30], ["extraversion", "<", 40]], "profile": "profile_introspective" },
      { "when": [["extraversion", "<", 30], ["conscientiousness", ">", 60]], "profile": "profile_quiet_achiever" },
      { "when": [["extraversion", "<", 30], ["intellect", ">", 60]], "profile": "profile_deep_thinker" },
      { "when": [["extraversion", ">", 70]], "profile": "profile_extrovert" },
      { "when": [["extraversion", "<", 30]], "profile": "profile_introvert" },
      {
        "when": [["@top1", ">", 65]],
        "profile": {
          "byTop": {
            "extraversion": "profile_extrovert",
            "agreeableness": "profile_peacemaker",
            "conscientiousness": "profile_achiever",
            "emotional_stability": "profile_steady",
            "intellect": "profile_explorer"
          }
        }
      }
    ],
    "$note": "Последнее правило — ветка «по доминирующему фактору», которая в оригинале срабатывает только если лидер выше 65."
  },

  "friendship_psychology_v1": {
    "$note": "Перенос determineProfile() из friendship_psychology_data.dart один в один. Первое правило — оригинальное «разрыв топ-1/топ-2 меньше 10 = смешанный»; оно же гарантирует, что в правиле communication_bridge сравнение с @top1 однозначно (ничьих наверху уже не бывает).",
    "mode": "rules",
    "fallback": "profile_mixed",
    "rules": [
      { "when": [["@diff12", "<", 10]], "profile": "profile_mixed" },
      { "when": [["emotional_closeness", ">=", 70], ["supportive_behavior", ">=", 70]], "profile": "warm_empathic_friend" },
      { "when": [["trust_and_loyalty", ">=", 70], ["emotional_closeness", "<", 70]], "profile": "reliable_stable_friend" },
      { "when": [["communication_style", ">=", 75], ["communication_style", ">=", "@top1"]], "profile": "communication_bridge" },
      { "when": [["supportive_behavior", ">=", 80], ["emotional_closeness", ">=", 60]], "profile": "caring_guardian" },
      { "when": [["boundaries_and_space", ">=", 70], ["friendship_expectations", "<", 50]], "profile": "independent_free_friend" },
      { "when": [["emotional_closeness", ">=", 70], ["boundaries_and_space", ">=", 70]], "profile": "philosophical_deep_friend" },
      { "when": [["supportive_behavior", ">=", 70], ["communication_style", ">=", 70]], "profile": "intuitive_feel_reader" },
      { "when": [["friendship_expectations", ">=", 70], ["communication_style", ">=", 65]], "profile": "social_circle_builder" },
      { "when": [["friendship_expectations", ">=", 65], ["supportive_behavior", ">=", 60], ["emotional_closeness", "<", 70]], "profile": "adventure_partner" },
      { "when": [["friendship_expectations", ">=", 70], ["supportive_behavior", ">=", 65]], "profile": "motivator_inspirer" },
      { "when": [["boundaries_and_space", ">=", 65], ["communication_style", "<", 60]], "profile": "calm_observer" },
      { "when": [["emotional_closeness", ">=", 70], ["friendship_expectations", ">=", 70]], "profile": "emotional_dramatic_friend" }
    ]
  },

  "values_priorities_v1": {
    "$note": "Перенос determineProfile() из values_priorities_data.dart. Композитные индексы оригинала (средняя важность, средняя энергия, средний |разрыв| по десяти парам важность/энергия) объявлены здесь как derived-операнды — движок считает их из тех же процентов.",
    "mode": "rules",
    "fallback": "profile_balanced",
    "derived": {
      "@importance": { "avg": ["security_importance", "freedom_importance", "achievement_importance", "creativity_importance", "relationships_importance", "growth_importance", "influence_importance", "comfort_importance", "contribution_importance", "health_balance_importance"] },
      "@energy": { "avg": ["security_energy", "freedom_energy", "achievement_energy", "creativity_energy", "relationships_energy", "growth_energy", "influence_energy", "comfort_energy", "contribution_energy", "health_balance_energy"] },
      "@alignment": { "avgAbsDiff": [
        ["security_importance", "security_energy"],
        ["freedom_importance", "freedom_energy"],
        ["achievement_importance", "achievement_energy"],
        ["creativity_importance", "creativity_energy"],
        ["relationships_importance", "relationships_energy"],
        ["growth_importance", "growth_energy"],
        ["influence_importance", "influence_energy"],
        ["comfort_importance", "comfort_energy"],
        ["contribution_importance", "contribution_energy"],
        ["health_balance_importance", "health_balance_energy"]
      ] }
    },
    "rules": [
      { "when": [["@alignment", "<", 15], ["@importance", ">=", 50], ["@energy", ">=", 50]], "profile": "profile_aligned" },
      { "when": [["@importance", ">=", 60], ["@energy", "<", 50]], "profile": "profile_values_without_action" },
      { "when": [["@energy", ">=", 50], ["@alignment", ">=", 25]], "profile": "profile_energy_misaligned" },
      { "when": [["@energy", ">=", 70], ["health_balance_energy", "<", 40]], "profile": "profile_burnout_risk" },
      { "when": [["freedom_importance", ">=", 70], ["security_importance", "<", 40]], "profile": "profile_freedom_seeker" },
      { "when": [["security_importance", ">=", 70], ["freedom_importance", "<", 40]], "profile": "profile_stability_seeker" },
      { "when": [["relationships_importance", ">=", 70], ["relationships_energy", ">=", 60]], "profile": "profile_relationships_focused" },
      { "when": [["growth_importance", ">=", 70], ["growth_energy", ">=", 60]], "profile": "profile_growth_oriented" }
    ]
  },

  "imposter_syndrome": {
    "$note": "Перенос determineProfile() из imposter_syndrome_data.dart: пороги по среднему всех шести факторов, как toxic_patterns.",
    "mode": "rules",
    "fallback": "profile_minimal",
    "rules": [
      { "when": [["@avg", ">=", 81]], "profile": "profile_severe" },
      { "when": [["@avg", ">=", 61]], "profile": "profile_high" },
      { "when": [["@avg", ">=", 41]], "profile": "profile_moderate" },
      { "when": [["@avg", ">=", 21]], "profile": "profile_mild" }
    ]
  },

  "social_battery_v1": {
    "$note": "Перенос determineProfile() из social_battery_data.dart: полосы по среднему, внутри полос — ветки по доминирующему фактору (доминанта = сравнение с @top1; при точной ничьей Dart брал первый по порядку обхода, у нас — совпадающий, расхождение только на ничьих). Последнее правило пустое — глубокий интроверт при среднем выше 85.",
    "mode": "rules",
    "fallback": "profile_balanced",
    "rules": [
      { "when": [["@avg", "<=", 25]], "profile": "profile_extrovert" },
      { "when": [["@avg", "<=", 40], ["recharge_method", ">=", "@top1"]], "profile": "profile_social_recharger" },
      { "when": [["@avg", "<=", 40], ["interaction_preference", ">=", "@top1"]], "profile": "profile_group_lover" },
      { "when": [["@avg", "<=", 40]], "profile": "profile_ambivert_social" },
      { "when": [["@avg", "<=", 60], ["capacity_flexibility", ">=", "@top1"], ["capacity_flexibility", ">", 60]], "profile": "profile_adaptive" },
      { "when": [["@avg", "<=", 60], ["social_anxiety", ">=", "@top1"], ["social_anxiety", ">", 60]], "profile": "profile_social_anxious" },
      { "when": [["@avg", "<=", 60]], "profile": "profile_balanced" },
      { "when": [["@avg", "<=", 75], ["solitude_need", ">=", "@top1"]], "profile": "profile_solitude_seeker" },
      { "when": [["@avg", "<=", 75], ["depletion_rate", ">=", "@top1"]], "profile": "profile_quick_drainer" },
      { "when": [["@avg", "<=", 75]], "profile": "profile_ambivert_introvert" },
      { "when": [["@avg", "<=", 85]], "profile": "profile_introvert" },
      { "when": [], "profile": "profile_deep_introvert" }
    ]
  },

  "sixteen_types": {
    "mode": "bipolar",
    "dimensions": [
      { "poles": ["extraversion", "introversion"], "letters": ["E", "I"] },
      { "poles": ["sensing", "intuition"], "letters": ["S", "N"] },
      { "poles": ["thinking", "feeling"], "letters": ["T", "F"] },
      { "poles": ["judging", "perceiving"], "letters": ["J", "P"] }
    ]
  }
}
